
:host {
  --ink: #14171f;
  --ink-soft: #1c202b;
  --line: #262b36;
  --paper: #f2f0ea;
  --amber: #c89b4a;
  --slate: #838a99;
  display: block;
  height: 100%;
}

.sidebar {
  width: 260px;
  background-color: var(--ink);
  color: #fff;
  display: flex;
  flex-direction: column;
  padding: 1rem;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  transition: transform 0.3s ease-in-out;
  z-index: 1000;
}

.sidebar h3 {
  font-family: 'Fraunces', serif;
  font-size: 1.2rem;
  margin-bottom: 0.5rem;
  color: var(--amber);
}

.sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0 0 1rem 0;
}

.sidebar li {
  margin: 0.5rem 0;
}

.sidebar a {
  text-decoration: none;
  color: var(--slate);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem;
  border-radius: 4px;
  transition: background 0.2s;
}

.sidebar a:hover {
  background-color: var(--ink-soft);
  color: #fff;
}

.sidebar a.active {
  background-color: var(--amber);
  color: var(--ink);
  font-weight: bold;
}

.sidebar__brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 8px 28px;
  margin-bottom: 12px;
  border-bottom: 1px solid var(--line);
}

.sidebar__mark {
  font-family: 'Fraunces', Georgia, serif;
  font-style: italic;
  font-size: 20px;
  color: var(--amber);
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 8px;
  flex-shrink: 0;
}

.sidebar__wordmark {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.sidebar__title {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 18px;
  letter-spacing: 0.01em;
}

.sidebar__subtitle {
  font-size: 12px;
  color: var(--slate);
  margin-top: 2px;
}

.sidebar__group-label {
  font-size: 11px;
  color: var(--slate);
  margin: 18px 8px 8px;
  letter-spacing: 0.02em;
}

.sidebar__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sidebar__link {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px 10px 16px;
  border-radius: 8px;
  text-decoration: none;
  color: var(--paper);
  transition: background-color 0.15s ease, color 0.15s ease;
}

.sidebar__link::before {
  content: '';
  position: absolute;
  left: -2px;
  top: 6px;
  bottom: 6px;
  width: 2px;
  border-radius: 2px;
  background: transparent;
  transition: background-color 0.15s ease;
}

.sidebar__link:hover {
  background: var(--ink-soft);
}

.sidebar__link--active {
  background: var(--ink-soft);
  color: var(--amber);
}

.sidebar__link--active::before {
  background: var(--amber);
}

.sidebar__link--active .sidebar__icon {
  color: var(--amber);
}

.sidebar__icon {
  width: 18px;
  height: 18px;
  color: var(--slate);
  display: grid;
  place-items: center;
  flex-shrink: 0;

  svg {
    width: 18px;
    height: 18px;
  }
}

.sidebar__label {
  font-size: 14px;
  font-weight: 500;
  flex: 1;
}

.sidebar__meta {
  font-size: 10.5px;
  color: var(--slate);
  font-variant-numeric: tabular-nums;
}

.sidebar__link--active .sidebar__meta {
  color: var(--amber);
  opacity: 0.75;
}

/* Botón toggle solo visible en móvil */
.toggle-btn {
  display: none;
  background: none;
  border: none;
  color: var(--amber);
  font-size: 1.5rem;
  cursor: pointer;
  margin-bottom: 1rem;
}

/* Overlay para móvil */
.sidebar-overlay {
  display: none;
}

@media (max-width: 720px) {
  .sidebar {
    transform: translateX(-100%); /* oculto por defecto */
    width: 220px;
    height: 100%;
  }

  .sidebar.open {
    transform: translateX(0); /* visible cuando isOpen = true */
  }

  .toggle-btn {
    display: block;
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1100;
  }

  .sidebar-overlay {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 900;
  }
}
